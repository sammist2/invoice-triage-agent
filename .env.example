# Copy this file to .env and fill it in. Never commit your real .env file.

# Which model to use: baseline, ollama, vllm, gemini, groq or custom
LLM_PROVIDER=ollama

# Model name. Defaults: ollama -> qwen2.5:7b, vllm -> Qwen/Qwen2.5-1.5B-Instruct.
# For gemini or groq, copy a current model name from the provider's docs.
# This applies to whichever provider you run, so --model on the command line is safer
# when you switch between providers.
LLM_MODEL=

# Only needed for "custom", or to point a preset at a different address
LLM_BASE_URL=

# API key for gemini or groq
LLM_API_KEY=

# Price per 1 million tokens in USD, used to estimate cost (0 for local or free-tier models)
LLM_INPUT_COST_PER_M=0
LLM_OUTPUT_COST_PER_M=0

# Where the mock business API runs
API_URL=http://127.0.0.1:8001
